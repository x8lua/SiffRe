local UI = assert(loadstring(game:HttpGet("https://raw.githubusercontent.com/x8lua/SiffRe/main/src/SiffRe.lua")))()
local window = UI:Window({Name = "SiffRe", FooterText = "SiffRe 1.0.0"})
window:KeybindList()
local main = window:Page({Name = "main"})
local section = main:Section({Name = "Settings", Side = 1})
local enabled = section:Toggle({Name = "Enabled", Flag = "Enabled", Default = false, Callback = function(value)
    print("Enabled", value)
end})
enabled:Keybind({Name = "Enabled", Default = Enum.KeyCode.H, Mode = "Toggle"})
section:Slider({Name = "Distance", Flag = "Distance", Min = 5, Max = 30, Default = 15, Decimals = 0.5, Suffix = " studs"})
section:Dropdown({Name = "Mode", Flag = "Mode", Items = {"Internal", "External"}, Default = "Internal"})
section:Button({Name = "Notify", Callback = function() UI:Notification("Settings updated", 3) end})
window:Init()
